@echo off
title Lanceur local - Interventions sur les arbres
cd /d "%~dp0"

REM ============================================================
REM  Lanceur local robuste
REM  - Pure ASCII, CRLF line endings, no BOM.
REM  - Linear flow with goto labels (no nested if blocks).
REM  - pause on every exit path so the window cannot vanish.
REM ============================================================

echo.
echo ============================================================
echo   Lanceur local - Interventions sur les arbres
echo ============================================================
echo.
echo Repertoire : %CD%
echo.

REM ----- Step 1: pick a Python interpreter ------------------------------
set "PYTHON_CMD="
for /f "delims=" %%P in ('where py 2^>nul') do (
    if not defined PYTHON_CMD set "PYTHON_CMD=py -3"
)
if not defined PYTHON_CMD (
    for /f "delims=" %%P in ('where python 2^>nul') do (
        if not defined PYTHON_CMD set "PYTHON_CMD=python"
    )
)
if not defined PYTHON_CMD (
    for /f "delims=" %%P in ('where python3 2^>nul') do (
        if not defined PYTHON_CMD set "PYTHON_CMD=python3"
    )
)
if not defined PYTHON_CMD goto :no_python

echo Lanceur Python : %PYTHON_CMD%
echo.

REM ----- Step 2: pick a free port starting at 8000 ----------------------
set "PORT=8000"
:port_loop
set "PORT_FREE=0"
for /f "tokens=*" %%R in ('netstat.exe -ano ^| findstr /R /C:":%PORT% " 2^>nul') do (
    set "PORT_FREE=1"
)
if "%PORT_FREE%"=="0" goto :port_ok
set /a PORT+=1
if %PORT% LSS 8100 goto :port_loop
echo.
echo ERREUR : aucun port libre entre 8000 et 8099.
echo.
pause
exit /b 1

:port_ok
echo Port choisi : %PORT%
echo.

REM ----- Step 3: write a tiny launcher PowerShell script ----------------
REM Caret-escape '>' and '&' so cmd does not interpret them as
REM redirection/command-chaining when echoing into the file.
set "TMPLOG=%TEMP%\lancer_local_server_%PORT%.log"
set "TMPPS1=%TEMP%\lancer_local_server_%PORT%.ps1"

>  "%TMPPS1%" echo #Auto-generated by lancer_local.bat
>> "%TMPPS1%" echo $ErrorActionPreference = "Continue"
>> "%TMPPS1%" echo Set-Location -LiteralPath '%CD%'
>> "%TMPPS1%" echo Write-Host ("Server starting on port %PORT% (root: " + (Get-Location).Path + ")")
>> "%TMPPS1%" echo Write-Host ("Log: %TMPLOG%")
>> "%TMPPS1%" echo try {
>> "%TMPPS1%" echo     ^& {%PYTHON_CMD% -m http.server %PORT% --bind 127.0.0.1 2^>^&1 ^| Tee-Object -FilePath '%TMPLOG%'}
>> "%TMPPS1%" echo } catch {
>> "%TMPPS1%" echo     Write-Host $_.Exception.Message
>> "%TMPPS1%" echo }
>> "%TMPPS1%" echo Read-Host 'Appuyez sur Entree pour fermer la fenetre du serveur'

echo Journal : %TMPLOG%
echo Lanceur : %TMPPS1%
echo.

REM ----- Step 4: start the server in a new window -----------------------
echo Demarrage du serveur dans une nouvelle fenetre...
start "Serveur HTTP port %PORT%" powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%TMPPS1%"

REM ----- Step 5: wait until the server accepts connections --------------
echo Attente du serveur (max 30 s) ...
set "ATTEMPTS=0"
:wait_loop
set /a ATTEMPTS+=1
if %ATTEMPTS% GTR 60 goto :wait_fail
powershell.exe -NoProfile -Command "$c=New-Object Net.Sockets.TcpClient;try{$c.Connect('127.0.0.1',%PORT%);$c.Close();exit 0}catch{exit 1}" >nul 2>&1
if not errorlevel 1 goto :wait_ok
ping -n 2 127.0.0.1 >nul
goto :wait_loop

:wait_ok
echo.
echo Le serveur repond sur http://localhost:%PORT%/
echo Ouverture du navigateur...
start "" "http://localhost:%PORT%/"
echo.
echo Le serveur tourne en arriere-plan dans une autre fenetre.
echo Pour arreter : fermez la fenetre du serveur OU cette fenetre-ci.
echo.
pause
exit /b 0

:wait_fail
echo.
echo ERREUR : le serveur n'a pas repondu apres 30 secondes.
echo Voir le journal : %TMPLOG%
echo.
echo --- Contenu du journal (si non vide) ---
if exist "%TMPLOG%" type "%TMPLOG%"
echo --- Fin du journal ---
echo.
pause
exit /b 1

:no_python
echo.
echo ERREUR : aucun interpreteur Python trouve.
echo          Installez Python 3 depuis https://www.python.org/
echo          ou assurez-vous que 'py' / 'python' est dans le PATH.
echo.
pause
exit /b 1
